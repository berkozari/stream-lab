# Example only. Copy to root .env.production (gitignored), then populate via your secrets system.
# NEVER use root development .env, demo passwords, or localhost service URLs for production.
NODE_ENV=production
DATABASE_URL=
REDIS_URL=
RATE_LIMIT_STORE=redis
CORS_ORIGINS=
TRUST_PROXY_CIDRS=
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_HMAC_SECRET=
AUTH_CSRF_SECRET=
PLAYBACK_SIGNING_SECRET=
PLAYBACK_PUBLIC_BASE_URL=
PLAYBACK_S3_PUBLIC_ENDPOINT=
PLAYBACK_TOKEN_TTL_SECONDS=60
S3_ENDPOINT=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_BUCKET=
S3_MEDIA_BUCKET=
# Set BOTH only if not using a workload identity / instance role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PORT=4000
LOG_LEVEL=info
WORKER_LOG_LEVEL=info
WORKER_CONCURRENCY=1
WORKER_METRICS_INTERVAL_MS=60000
TRANSCODE_MAX_DURATION_SECONDS=14400
TRANSCODE_MAX_SOURCE_PIXELS=8294400
TRANSCODE_MIN_SCRATCH_FREE_BYTES=536870912
TRANSCODE_FFMPEG_THREADS=2
TRANSCODE_FFMPEG_PROFILE_TIMEOUT_MS=7200000
