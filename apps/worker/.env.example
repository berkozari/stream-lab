# The worker reads the repository-root .env; this file documents optional overrides.
# REDIS_URL=redis://127.0.0.1:6379
# WORKER_CONCURRENCY=1
# Production media budget defaults: 4 hours, 4K pixels, 512 MiB temp reserve.
# Size and concurrency must be calibrated on staging with real media workloads.
# TRANSCODE_MAX_DURATION_SECONDS=14400
# TRANSCODE_MAX_SOURCE_PIXELS=8294400
# TRANSCODE_MIN_SCRATCH_FREE_BYTES=536870912
# TRANSCODE_FFMPEG_THREADS=2
# TRANSCODE_FFMPEG_PROFILE_TIMEOUT_MS=7200000
