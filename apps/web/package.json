{
  "name": "@streamlab/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test:auth": "node --experimental-strip-types --test tests/auth-state.test.ts tests/auth-utils.test.ts",
    "test:auth:ui": "node --experimental-strip-types --test tests/auth-ui.test.ts",
    "test:video:client": "node --experimental-strip-types --test tests/video-query.test.ts tests/video-client.test.ts",
    "test:video:ui": "node --experimental-strip-types --test tests/video-ui.test.ts"
  },
  "dependencies": {
    "@streamlab/contracts": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.400.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.0.0"
  }
}
