{
  "name": "@streamlab/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:typecheck": "tsc --noEmit -p tsconfig.db.json",
    "test:foundation": "node --import tsx --test tests/integration/backend-foundation.test.ts tests/unit/validate.middleware.test.ts",
    "test:api:foundation": "pnpm --filter @streamlab/api test:foundation",
    "smoke:api": "node scripts/api-smoke.mjs",
    "queue:smoke": "tsx scripts/queue-smoke.ts",
    "test:register": "node --import tsx --test tests/unit/auth-register.service.test.ts tests/integration/auth-register.http.test.ts",
    "smoke:register": "tsx scripts/auth-register-smoke.ts",
    "test:login": "node --import tsx --test tests/unit/auth-login.service.test.ts tests/integration/auth-login.http.test.ts",
    "smoke:login": "tsx scripts/auth-login-smoke.ts",
    "test:refresh": "node --import tsx --test tests/unit/refresh.service.test.ts tests/integration/auth-refresh.http.test.ts",
    "smoke:refresh": "tsx scripts/auth-refresh-smoke.ts",
    "test:session": "node --import tsx --test tests/unit/session-authorization.test.ts tests/integration/auth-session.http.test.ts",
    "smoke:session": "tsx scripts/auth-session-smoke.ts",
    "test:security": "node --import tsx --test tests/unit/auth-security-hardening.test.ts tests/integration/auth-security.http.test.ts",
    "smoke:security": "tsx scripts/auth-security-smoke.ts",
    "smoke:video:model": "tsx scripts/video-domain-smoke.ts",
    "test:video:create": "node --import tsx --test tests/unit/video-create.service.test.ts tests/integration/video-create.http.test.ts",
    "smoke:video:create": "tsx scripts/video-create-smoke.ts",
    "test:video:read": "node --import tsx --test tests/unit/video-read.service.test.ts tests/integration/video-read.http.test.ts",
    "smoke:video:read": "tsx scripts/video-read-smoke.ts",
    "test:video:update": "node --import tsx --test tests/unit/video-update.service.test.ts tests/integration/video-update.http.test.ts",
    "smoke:video:update": "tsx scripts/video-update-smoke.ts",
    "test:video:delete": "node --import tsx --test tests/unit/video-delete.service.test.ts tests/integration/video-delete.http.test.ts",
    "smoke:video:delete": "tsx scripts/video-delete-smoke.ts",
    "test:upload:storage": "node --import tsx --test tests/unit/storage.service.test.ts",
    "smoke:upload:storage": "tsx scripts/storage-smoke.ts",
    "test:upload:session": "node --import tsx --test tests/unit/upload-session.service.test.ts tests/integration/upload-session.http.test.ts",
    "smoke:upload:session": "tsx scripts/upload-session-smoke.ts",
    "test:upload:sign": "node --import tsx --test tests/unit/upload-sign.service.test.ts tests/integration/upload-sign.http.test.ts",
    "smoke:upload:sign": "tsx scripts/upload-sign-smoke.ts",
    "test:upload:complete": "node --import tsx --test tests/unit/upload-complete.service.test.ts tests/unit/upload-verify-storage.test.ts tests/integration/upload-complete.http.test.ts",
    "smoke:upload:complete": "tsx scripts/upload-complete-smoke.ts",
    "test:upload:multipart": "node --import tsx --test tests/unit/multipart-parts.test.ts tests/unit/upload-multipart.service.test.ts tests/integration/upload-multipart.http.test.ts",
    "smoke:upload:multipart": "tsx scripts/upload-multipart-smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@streamlab/contracts": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7",
    "bullmq": "^6.7.8",
    "argon2": "^0.45.2",
    "jose": "^6.2.18",
    "express-rate-limit": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.0"
  }
}
