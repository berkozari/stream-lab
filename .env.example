POSTGRES_USER=streamlab
POSTGRES_PASSWORD=streamlab_dev_password_change_me
POSTGRES_DB=streamlab
POSTGRES_PORT=5432

REDIS_PORT=6379

S3_ROOT_USER=streamlabadmin
S3_ROOT_PASSWORD=streamlab_local_secret_change_me
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_UPLOAD_BUCKET=streamlab-uploads
S3_MEDIA_BUCKET=streamlab-media

# STREAM-002.2: generate real local values with pnpm setup:auth:secrets
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_HMAC_SECRET=
AUTH_CSRF_SECRET=

# STREAM-004.3: Browser-reachable host URL for SigV4 PUT URLs; use HTTPS in production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# For production, use dedicated S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY or an IAM role.
