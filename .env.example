POSTGRES_USER=streamlab
POSTGRES_PASSWORD=streamlab_dev_password_change_me
POSTGRES_DB=streamlab
POSTGRES_PORT=5432

REDIS_PORT=6379

S3_ROOT_USER=streamlabadmin
S3_ROOT_PASSWORD=streamlab_local_secret_change_me
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_UPLOAD_BUCKET=streamlab-uploads
S3_MEDIA_BUCKET=streamlab-media
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_HMAC_SECRET=
AUTH_CSRF_SECRET=

FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

PLAYBACK_SIGNING_SECRET=
PLAYBACK_PUBLIC_BASE_URL=http://localhost:4000
PLAYBACK_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
PLAYBACK_TOKEN_TTL_SECONDS=60

# Memory counters are for single-process local development/tests only.
RATE_LIMIT_STORE=memory
# In production: RATE_LIMIT_STORE=redis and supply an authenticated REDIS_URL.
# REDIS_URL=redis://username:password@redis.example.internal:6379
# Exact addresses/CIDRs of your own ingress proxies, never 0.0.0.0/0.
TRUST_PROXY_CIDRS=

# STREAM-009.3: optional transcoding media and scratch-disk budgets.
# The worker reads these from this root .env at startup.
# TRANSCODE_MAX_DURATION_SECONDS=14400
# TRANSCODE_MAX_SOURCE_PIXELS=8294400
# TRANSCODE_MIN_SCRATCH_FREE_BYTES=536870912
# TRANSCODE_FFMPEG_THREADS=2
# TRANSCODE_FFMPEG_PROFILE_TIMEOUT_MS=7200000

# STREAM-009.5: optional structured worker observability.
# WORKER_LOG_LEVEL=info
# WORKER_METRICS_INTERVAL_MS=60000
