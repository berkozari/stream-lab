{
  "name": "streamlab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm db:generate && pnpm -r --if-present build",
    "check": "pnpm verify:scaffold && pnpm verify:standards && pnpm lint && pnpm typecheck && pnpm format:check && pnpm build && pnpm verify:worker:foundation && pnpm test:worker:foundation && pnpm verify:api:contracts && pnpm test:api:contracts && pnpm verify:integration && pnpm test:integration:smoke && pnpm verify:auth:register && pnpm test:auth:register && pnpm verify:auth:login && pnpm test:auth:login && pnpm verify:auth:refresh && pnpm test:auth:refresh && pnpm verify:auth:session && pnpm test:auth:session && pnpm verify:web:auth && pnpm test:web:auth && pnpm verify:web:auth:ui && pnpm test:web:auth:ui && pnpm verify:auth:security && pnpm test:auth:security && pnpm verify:auth:e2e && pnpm verify:video:model && pnpm verify:video:contracts && pnpm verify:video:create && pnpm test:video:create && pnpm verify:video:read && pnpm test:video:read && pnpm verify:video:update && pnpm test:video:update && pnpm verify:video:delete && pnpm test:video:delete && pnpm verify:web:video && pnpm test:web:video && pnpm verify:web:video:ui && pnpm test:web:video:ui && pnpm verify:video:e2e && pnpm verify:upload:architecture && pnpm test:upload:architecture && pnpm verify:upload:contracts && pnpm test:upload:contracts && pnpm verify:upload:storage && pnpm test:upload:storage && pnpm verify:upload:session && pnpm test:upload:session && pnpm verify:upload:sign && pnpm test:upload:sign && pnpm verify:upload:complete && pnpm test:upload:complete && pnpm verify:upload:multipart && pnpm test:upload:multipart && pnpm verify:web:upload && pnpm test:web:upload && pnpm verify:upload:e2e",
    "dev": "pnpm --filter @streamlab/contracts build && pnpm --parallel --filter @streamlab/web --filter @streamlab/api --filter @streamlab/worker run dev",
    "dev:api": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/api dev",
    "dev:web": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/web dev",
    "dev:worker": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "node scripts/setup-hooks.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "typecheck": "pnpm db:generate && pnpm --filter @streamlab/contracts build && pnpm -r --if-present typecheck && pnpm --filter @streamlab/api db:typecheck",
    "verify:scaffold": "node scripts/verify-scaffold.mjs",
    "verify:standards": "node scripts/verify-standards.mjs",
    "db:validate": "pnpm --filter @streamlab/api db:validate",
    "db:generate": "pnpm --filter @streamlab/api db:generate",
    "db:migrate:dev": "pnpm --filter @streamlab/api db:migrate:dev",
    "db:migrate:status": "pnpm --filter @streamlab/api db:migrate:status",
    "db:migrate:deploy": "pnpm --filter @streamlab/api db:migrate:deploy",
    "db:seed": "pnpm --filter @streamlab/api db:seed",
    "db:smoke": "pnpm --filter @streamlab/api db:smoke",
    "test:api:foundation": "pnpm --filter @streamlab/api test:foundation",
    "test:foundation": "node --import tsx --test tests/integration/backend-foundation.test.ts tests/unit/validate.middleware.test.ts",
    "smoke:api": "pnpm --filter @streamlab/api smoke:api",
    "verify:web:foundation": "node scripts/verify-stream-001-7.mjs",
    "smoke:queue": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/api queue:smoke",
    "test:worker:foundation": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/worker test:foundation",
    "verify:worker:foundation": "node scripts/verify-stream-001-8.mjs",
    "verify:api:contracts": "node scripts/verify-stream-001-9.mjs",
    "test:api:contracts": "pnpm --filter @streamlab/contracts test",
    "verify:integration": "node scripts/verify-stream-001-10.mjs",
    "test:integration:smoke": "node --test scripts/tests/http-checks.test.mjs",
    "smoke:integration": "node scripts/smoke-integration.mjs",
    "verify:auth:register": "node scripts/verify-stream-002-2.mjs",
    "setup:auth:secrets": "node scripts/setup-auth-secrets.mjs",
    "test:auth:register": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/api test:register",
    "smoke:auth:register": "pnpm --filter @streamlab/api smoke:register",
    "verify:auth:login": "node scripts/verify-stream-002-3.mjs",
    "test:auth:login": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/api test:login",
    "smoke:auth:login": "pnpm --filter @streamlab/api smoke:login",
    "verify:auth:refresh": "node scripts/verify-stream-002-4.mjs",
    "test:auth:refresh": "pnpm --filter @streamlab/api test:refresh",
    "smoke:auth:refresh": "pnpm --filter @streamlab/api smoke:refresh",
    "verify:auth:session": "node scripts/verify-stream-002-5.mjs",
    "test:auth:session": "pnpm --filter @streamlab/api test:session",
    "smoke:auth:session": "pnpm --filter @streamlab/api smoke:session",
    "verify:web:auth": "node scripts/verify-stream-002-6.mjs",
    "test:web:auth": "pnpm --filter @streamlab/web test:auth",
    "verify:web:auth:ui": "node scripts/verify-stream-002-7.mjs",
    "test:web:auth:ui": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/web test:auth:ui",
    "verify:auth:security": "node scripts/verify-stream-002-8.mjs",
    "test:auth:security": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/api test:security",
    "smoke:auth:security": "pnpm --filter @streamlab/api smoke:security",
    "verify:auth:e2e": "node scripts/verify-stream-002-9.mjs",
    "test:auth:e2e": "playwright test apps/web/tests/e2e/auth-flow.spec.ts --config=playwright.config.ts",
    "test:auth:e2e:headed": "playwright test apps/web/tests/e2e/auth-flow.spec.ts --config=playwright.config.ts --headed",
    "verify:video:model": "node scripts/verify-stream-003-1.mjs",
    "smoke:video:model": "pnpm --filter @streamlab/api smoke:video:model",
    "verify:video:contracts": "node scripts/verify-stream-003-2.mjs",
    "test:video:contracts": "pnpm --filter @streamlab/contracts build && node --test packages/contracts/tests/video-metadata.test.mjs",
    "verify:video:create": "node scripts/verify-stream-003-3.mjs",
    "test:video:create": "pnpm --filter @streamlab/api test:video:create",
    "smoke:video:create": "pnpm --filter @streamlab/api smoke:video:create",
    "verify:video:read": "node scripts/verify-stream-003-4.mjs",
    "test:video:read": "pnpm --filter @streamlab/api test:video:read",
    "smoke:video:read": "pnpm --filter @streamlab/api smoke:video:read",
    "verify:video:update": "node scripts/verify-stream-003-5.mjs",
    "test:video:update": "pnpm --filter @streamlab/api test:video:update",
    "smoke:video:update": "pnpm --filter @streamlab/api smoke:video:update",
    "verify:video:delete": "node scripts/verify-stream-003-6.mjs",
    "test:video:delete": "pnpm --filter @streamlab/api test:video:delete",
    "smoke:video:delete": "pnpm --filter @streamlab/api smoke:video:delete",
    "verify:web:video": "node scripts/verify-stream-003-7.mjs",
    "test:web:video": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/web test:video:client",
    "verify:web:video:ui": "node scripts/verify-stream-003-8.mjs",
    "test:web:video:ui": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/web test:video:ui",
    "verify:video:e2e": "node scripts/verify-stream-003-9.mjs",
    "test:video:e2e": "playwright test apps/web/tests/e2e/video-management.spec.ts --config=playwright.config.ts",
    "test:video:e2e:headed": "playwright test apps/web/tests/e2e/video-management.spec.ts --config=playwright.config.ts --headed",
    "verify:upload:architecture": "node scripts/verify-stream-004-1.mjs",
    "test:upload:architecture": "node --test tests/architecture/upload-security-policy.test.mjs",
    "verify:upload:contracts": "node scripts/verify-stream-004-2.mjs",
    "test:upload:contracts": "pnpm --filter @streamlab/contracts build && node --test packages/contracts/tests/upload-contracts.test.mjs",
    "verify:upload:storage": "node scripts/verify-stream-004-3.mjs",
    "test:upload:storage": "pnpm --filter @streamlab/api test:upload:storage",
    "smoke:upload:storage": "pnpm --filter @streamlab/api smoke:upload:storage",
    "verify:upload:session": "node scripts/verify-stream-004-4.mjs",
    "test:upload:session": "pnpm --filter @streamlab/api test:upload:session",
    "smoke:upload:session": "pnpm --filter @streamlab/api smoke:upload:session",
    "verify:upload:sign": "node scripts/verify-stream-004-5.mjs",
    "test:upload:sign": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/api test:upload:sign && pnpm --filter @streamlab/web test:upload:direct",
    "smoke:upload:sign": "pnpm --filter @streamlab/api smoke:upload:sign",
    "verify:upload:complete": "node scripts/verify-stream-004-6.mjs",
    "test:upload:complete": "pnpm --filter @streamlab/api test:upload:complete",
    "smoke:upload:complete": "pnpm --filter @streamlab/api smoke:upload:complete",
    "verify:upload:multipart": "node scripts/verify-stream-004-7.mjs",
    "test:upload:multipart": "pnpm --filter @streamlab/api test:upload:multipart",
    "smoke:upload:multipart": "pnpm --filter @streamlab/api smoke:upload:multipart",
    "verify:web:upload": "node scripts/verify-stream-004-8.mjs",
    "test:web:upload": "pnpm --filter @streamlab/contracts build && pnpm --filter @streamlab/web test:upload:ui",
    "verify:upload:e2e": "node scripts/verify-stream-004-9.mjs",
    "test:upload:e2e": "pnpm exec playwright test apps/web/tests/e2e/upload-security.spec.ts",
    "test:upload:e2e:large": "STREAMLAB_E2E_LARGE_UPLOAD=1 pnpm test:upload:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.9.1",
    "@playwright/test": "^1.65.1"
  }
}
